{
  "name": "winc-task-hub",
  "version": "1.0.0",
  "description": "WINC TASK HUB — Gerenciador Inteligente de Tarefas e Lembretes Persistentes",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"npm run vite:dev\" \"cross-env NODE_ENV=development VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "vite:dev": "vite",
    "vite:build": "vite build",
    "start": "electron .",
    "test": "node tests/app.test.js",
    "pack": "npm run vite:build && electron-builder --dir",
    "dist": "npm run vite:build && electron-builder"
  },
  "build": {
    "appId": "com.winc.taskhub",
    "productName": "WINC TASK HUB",
    "copyright": "Copyright © 2026 Agência Winc",
    "npmRebuild": false,
    "files": [
      "dist/**/*",
      "electron/**/*",
      "resources/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "WINC TASK HUB"
    }
  },
  "keywords": [
    "productivity",
    "electron",
    "task-manager",
    "winc",
    "evilbear"
  ],
  "author": "Agência Winc",
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "framer-motion": "^14.7.1",
    "lucide-react": "^1.63.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.9",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
